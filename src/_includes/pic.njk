{% macro pic(name, alt, sizes, widths, cls="", eager=false) %}<img class="{{ cls }}" src="/images/{{ name }}-{{ widths[0] }}.webp" srcset="{% for w in widths %}/images/{{ name }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}" alt="{{ alt }}" {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">{% endmacro %}
{% macro banner(name, alt, widths) %}<section class="page-banner"><div class="wrap"><figure>{{ pic(name, alt, "(max-width: 1180px) 100vw, 1180px", widths, "", true) }}</figure></div></section>{% endmacro %}
