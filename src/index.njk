---
layout: base.njk
preloadHero: true
bodyClass: home
---
{% from "pic.njk" import pic %}

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>{{ home.heroTitle }}</h1>
      <p class="lede">{{ home.heroText }}</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href="/book/">Book a visit</a>
        <a class="btn btn-ghost btn-lg" href="tel:{{ site.phone | tel }}">Call {{ site.phone }}</a>
      </div>
      <ul class="ticks">
        {% for p in home.heroPoints %}<li>{{ p }}</li>{% endfor %}
      </ul>
    </div>
    <figure class="hero-photo">
      <div class="arch">{{ pic("hero", "A woman relaxes on her sofa during a video visit on her laptop", "(max-width: 860px) 92vw, 44vw", [560, 900, 1200], "", true) }}</div>
      <figcaption class="hero-tag">Secure video visits<br><span>Anywhere in Florida</span></figcaption>
    </figure>
  </div>
  <svg class="pulse" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path pathLength="1" d="M0 96 H520 l22 0 l14 -18 l14 30 l12 -12 H640 l18 -70 l26 118 l20 -64 l14 16 H1180"/>
    <circle cx="1188" cy="80" r="7"/>
  </svg>
</section>

<section class="section who">
  <div class="wrap">
    <h2 class="h2 center">{{ home.whoTitle }}</h2>
    <div class="who-grid">
      {% for w in home.who %}
      <article class="who-item">
        <div class="arch arch-sm">{{ pic(w.image, "", "(max-width: 760px) 80vw, 30vw", [480, 800]) }}</div>
        <h3>{{ w.title }}</h3>
        <p>{{ w.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section services-band">
  <div class="wrap svc-grid">
    <div class="svc-intro">
      <h2 class="h2">What we help with</h2>
      <p>{{ services.intro }}</p>
      <a class="text-link" href="/services/">Explore all services</a>
    </div>
    <ul class="svc-list">
      {% for s in services.items %}
      <li><h3>{{ s.name }}</h3><p>{{ s.short }}</p></li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section steps-band">
  <div class="wrap">
    <h2 class="h2 center">Your first visit, step by step</h2>
    <ol class="steps">
      <li><h3>Choose how to book</h3><p>Book online through your insurance with Headway or Grow Therapy, or call us to book as a self-pay patient.</p></li>
      <li><h3>Complete secure intake</h3><p>Fill out your forms on a protected patient platform, never by email. Your coverage is checked before you're seen.</p></li>
      <li><h3>Meet Ada by video</h3><p>Join from your phone, tablet or computer. Your evaluation ends with a plan you understand and agree with.</p></li>
    </ol>
    <p class="center"><a class="btn btn-primary" href="/book/">See booking options</a></p>
  </div>
</section>

<section class="section about-band">
  <div class="wrap about-grid">
    <figure class="about-photo">
      {{ pic("office", "A calm reception area with lavender chairs and the practice logo", "(max-width: 860px) 92vw, 50vw", [800, 1400]) }}
    </figure>
    <div class="about-copy">
      <h2 class="h2">{{ home.aboutTitle }}</h2>
      <p>{{ home.aboutText }}</p>
      <blockquote><p>{{ home.aboutQuote }}</p><footer>{{ site.provider }}, {{ site.credentials }}</footer></blockquote>
      <a class="text-link" href="/about/">Read Ada's approach</a>
    </div>
  </div>
</section>

{% if site.showMelissa %}
<section class="dawn" aria-labelledby="dawn-h">
  {{ pic("sunrise", "", "100vw", [900, 1600, 2400], "dawn-img") }}
  <div class="wrap dawn-in">
    <div class="dawn-card">
      <h2 id="dawn-h" class="h2">{{ home.melissaTitle }}</h2>
      <p>{{ home.melissaText }}</p>
      <div class="actions">
        <a class="btn btn-primary" href="tel:{{ site.phone | tel }}">Call {{ site.phone }}</a>
        <button class="btn btn-ghost" type="button" data-melissa-open>Talk to her online</button>
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="section insurance-band">
  <div class="wrap ins-grid">
    <div>
      <h2 class="h2">Insurance and self-pay</h2>
      <p>{{ insurance.intro }}</p>
      <a class="text-link" href="/insurance/">Coverage and fees</a>
    </div>
    <ul class="plan-cloud">
      {% for p in insurance.plans %}<li>{{ p }}</li>{% endfor %}
      <li class="plan-self">Self-pay welcome</li>
    </ul>
  </div>
</section>

<section class="section closing">
  <div class="wrap closing-in">
    <h2 class="h2">Ready when you are.</h2>
    <p>Taking the first step is often the hardest part. We'll make the rest simple.</p>
    <div class="actions center-actions">
      <a class="btn btn-primary btn-lg" href="/book/">Book a visit</a>
      <a class="btn btn-ghost btn-lg" href="tel:{{ site.phone | tel }}">Call {{ site.phone }}</a>
    </div>
  </div>
</section>
